# Copy this file to .env and adjust the values for your environment.

# MongoDB connection (local single-node replica set by default)
MONGO_CONNECTION_STRING=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DATABASE=swift_bank

# Redis (cache-aside)
REDIS_HOSTS=redis://localhost:6379
ACCOUNT_CACHE_TTL_SECONDS=60

# Seed fake data on startup (only when the database is empty)
SEED_ENABLED=true

# HTTP
QUARKUS_HTTP_PORT=8080
